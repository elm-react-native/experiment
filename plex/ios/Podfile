require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

def add_preprocessor_definitions(build_settings, definitions)
  current = build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
  current = current.split if current.is_a?(String)
  definitions.each do |definition|
    current << definition unless current.include?(definition)
  end
  build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = current
end

def remove_preprocessor_definitions(build_settings, definitions)
  current = build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
  current = current.split if current.is_a?(String)
  current -= definitions
  current = ['$(inherited)'] if current.empty?
  build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = current
end

def update_preprocessor_definitions_in_xcconfig(path, add_definitions, remove_definitions)
  contents = File.read(path)
  if contents.match?(/^GCC_PREPROCESSOR_DEFINITIONS = /)
    contents = contents.gsub(/^GCC_PREPROCESSOR_DEFINITIONS = (.*)$/) do
      current = Regexp.last_match(1).split
      current -= remove_definitions
      add_definitions.each do |definition|
        current << definition unless current.include?(definition)
      end
      current = ['$(inherited)'] if current.empty?
      "GCC_PREPROCESSOR_DEFINITIONS = #{current.join(' ')}"
    end
  else
    definitions = ['$(inherited)', *add_definitions]
    contents << "\nGCC_PREPROCESSOR_DEFINITIONS = #{definitions.join(' ')}\n"
  end
  File.write(path, contents)
end

def debug_configuration?(name)
  name.to_s.downcase.include?('debug')
end

def align_react_native_prebuilt_settings(installer)
  app_definitions = ['FOLLY_CFG_NO_COROUTINES=1']
  production_definitions = ['REACT_NATIVE_PRODUCTION=1']

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if debug_configuration?(config.name)
        remove_preprocessor_definitions(config.build_settings, production_definitions)
      else
        add_preprocessor_definitions(config.build_settings, production_definitions)
      end
    end
  end

  xcconfig_paths = Dir.glob(
    File.join(installer.sandbox.root.to_s, 'Target Support Files', 'Pods-Plex*', 'Pods-Plex*.xcconfig')
  )

  xcconfig_paths.each do |path|
    if debug_configuration?(File.basename(path))
      update_preprocessor_definitions_in_xcconfig(path, app_definitions, production_definitions)
    else
      update_preprocessor_definitions_in_xcconfig(path, app_definitions + production_definitions, [])
    end
  end
end

target 'Plex' do
  config = use_native_modules!

  pod 'MobileVLCKit', '3.7.3'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'PlexTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      # Set `mac_catalyst_enabled` to `true` in order to apply patches
      # necessary for Mac Catalyst builds
      :mac_catalyst_enabled => false
    )
    align_react_native_prebuilt_settings(installer)
    # __apply_Xcode_12_5_M1_post_install_workaround(installer)
  end
end
